// Fictional constraints and adaptation guidance are in references/diagramming-style.md.
// Palette is supplied by render_light / render_dark; keep this definition theme-independent.
digraph ReportER {
  graph [label="Record relationships\n", labelloc=t, fontname="Trebuchet MS",
         fontsize=15, rankdir=TB, margin=0, pad=0.20, nodesep=0.55,
         ranksep=0.95, splines=polyline];
  node [shape=plain, fontname="Trebuchet MS", fontsize=15];
  edge [fontname="Trebuchet MS", fontsize=13, penwidth=1.3, arrowsize=0.9];

  team [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD>
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD COLSPAN="2"><B>Team</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">TeamID</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Name</TD></TR>
      </TABLE>
    </TD></TR></TABLE>
  >];
  category [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD>
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD COLSPAN="2"><B>Category</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">CategoryID</TD></TR>
        <TR><TD></TD><TD ALIGN="LEFT">Name</TD></TR>
      </TABLE>
    </TD></TR></TABLE>
  >];
  record [label=<
    <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8"><TR><TD>
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3">
        <TR><TD COLSPAN="2"><B>Record</B></TD></TR>
        <TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">RecordID</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">TeamID (nullable)</TD></TR>
        <TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">CategoryID (NOT NULL)</TD></TR>
        <TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">ExternalKey</TD></TR>
      </TABLE>
    </TD></TR></TABLE>
  >];

  { rank=same; team; category; }
  team -> record [dir=both, arrowtail=teeodot, arrowhead=crowodot];
  category -> record [dir=both, arrowtail=teetee, arrowhead=crowodot];
}
