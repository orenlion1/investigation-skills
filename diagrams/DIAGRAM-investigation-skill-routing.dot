// Independent skill routes; peer placement is not an execution-order edge.
// Coverage manifest, checked by scripts/check-docs-drift.py against the root routing table:
// workflow-artifact-naming, open-edit-close-execute, profile-manager, token-usage,
// diagramming-style, report-evidence, source-investigation, publish-it, rovo-dev-mcp,
// aws-mcp, aws-architecture-diagrams, gcx-cli, slack-mcp, rhyming-incident-search,
// per-store-fan-out, parallel-alert-investigation, release-it.
// Activity labels carry the Open/Edit/Close/Execute mode they run in, matching
// the lifecycle view. Dashed edges invoke or route; the solid edge delivers.
digraph InvestigationSkillRouting {
  graph [rankdir=TB, margin=0, pad=0.3, nodesep=0.85, ranksep=0.9,
         fontname="Trebuchet MS", fontsize=15, splines=polyline];
  node [shape=plaintext, fontname="Trebuchet MS", fontsize=15, margin="0.25,0.10"];
  edge [fontname="Trebuchet MS", fontsize=12, arrowsize=0.7, penwidth=1.2];

  initialize [label="Initialize\nOpen and Edit"];
  investigate [label="Investigate\nClose and Execute"];
  report [label="Report"];
  publish [label="Publish"];
  setup_skills [label="Skills\nWorkflow Artifact Naming\nOpen/Edit/Close/Execute\nProfile Manager"];
  orchestration_skills [label="Orchestration skills\nPer-Store Fan-Out\nParallel Alert Investigation\nRhyming Incident Search"];
  resource_skills [label="Resource skills\nRovo Dev MCP / Grafana CLI\nSlack MCP / AWS MCP\nSource Investigation"];
  report_skills [label="Report skills\nWorkflow Artifact Naming\nToken Usage / Report Evidence\nDiagramming Style\nAWS Architecture Diagrams"];
  publish_skills [label="Publish skills\nPublish It / Release It\nRovo Dev MCP"];
  destination [label="Repository or content system\nNext lifecycle step picks it up"];

  { rank=same; initialize; investigate; report; publish; }
  { rank=same; setup_skills; orchestration_skills; report_skills; publish_skills; destination; }
  initialize -> investigate -> report -> publish [style=invis, weight=100];
  initialize -> setup_skills [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="16"></TD><TD>invokes</TD></TR></TABLE>>, style=dashed];
  investigate -> orchestration_skills [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="16"></TD><TD>routes</TD></TR></TABLE>>, style=dashed];
  orchestration_skills -> resource_skills [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="16"></TD><TD>invokes</TD></TR></TABLE>>, style=dashed];
  report -> report_skills [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="16"></TD><TD>invokes</TD></TR></TABLE>>, style=dashed];
  publish -> publish_skills [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="16"></TD><TD>invokes</TD></TR></TABLE>>, style=dashed];
  publish_skills -> destination [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD WIDTH="16"></TD><TD>delivers to</TD></TR></TABLE>>];
}
