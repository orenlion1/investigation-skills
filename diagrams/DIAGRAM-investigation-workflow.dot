// Canonical activity/artifact overview; palettes are supplied by the renderer.
digraph InvestigationWorkflow {
  graph [rankdir=LR, newrank=true, margin=0, pad=0.3, nodesep=1.0, ranksep=0.8,
         fontname="Trebuchet MS", fontsize=15, splines=polyline];
  node [shape=plaintext, fontname="Trebuchet MS", fontsize=15, margin="0.25,0.10"];
  edge [fontname="Trebuchet MS", fontsize=12, arrowsize=0.7, penwidth=1.2];

  initialize [label="Initialize"];
  close_editor [label="Save and close"];
  investigate [label="Investigate"];
  report [label="Report"];
  draft [label="TASK.md"];
  saved [label="Saved TASK"];
  evidence [label="Findings and evidence"];
  outputs [label="Markdown + PDF"];

  { rank=same; initialize; draft; }
  { rank=same; close_editor; saved; }
  { rank=same; investigate; evidence; }
  { rank=same; report; outputs; }

  initialize -> close_editor [label="opens editor", weight=100];
  close_editor -> investigate [label="starts execution", weight=100];
  investigate -> report [label="passes findings", weight=100];
  initialize -> draft [xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD>produces</TD><TD WIDTH="16"></TD></TR></TABLE>>, constraint=false];
  close_editor -> saved [xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD>saves</TD><TD WIDTH="16"></TD></TR></TABLE>>, constraint=false];
  investigate -> evidence [xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD>produces</TD><TD WIDTH="16"></TD></TR></TABLE>>, constraint=false];
  report -> outputs [xlabel=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="0"><TR><TD>produces</TD><TD WIDTH="16"></TD></TR></TABLE>>, constraint=false];
}
