// Modeled on agent-tasks/docs/diagrams/HOW-A-TASK-FLOWS.dot.
// One canonical layout; the renderer supplies the light and dark palettes.
digraph InvestigationWorkflow {
  rankdir=TB; newrank=true; compound=true;
  graph [fontname="Trebuchet MS", fontsize=14, splines=true,
         nodesep=0.65, ranksep=1.1];
  node [fontname="Trebuchet MS", fontsize=12, style=filled, height=0.45];
  edge [fontname="Trebuchet MS", fontsize=11];

  subgraph cluster_lifecycle {
    label="Investigation lifecycle"; labeljust=l; style=filled;
    initialize [shape=oval, label="Open and Edit"];
    close_editor [shape=oval, label="Save and close"];
    investigate [shape=oval, label="Investigate"];
    report [shape=oval, label="Report"];
    publish [shape=oval, label="Publish"];
    { rank=same; initialize; close_editor; investigate; report; publish; }
    initialize -> close_editor -> investigate -> report -> publish [weight=100];
  }

  subgraph cluster_integrations {
    label="Investigation integrations"; labeljust=l; labelloc=b; style=filled;
    aws_mcp [shape=box, label="aws-mcp"];
    gcx_cli [shape=box, label="gcx-cli"];
    slack_mcp [shape=box, label="slack-mcp"];
    rovo_dev_mcp [shape=box, label="rovo-dev-mcp"];
    { rank=same; aws_mcp; gcx_cli; slack_mcp; rovo_dev_mcp; }
    aws_mcp -> gcx_cli -> slack_mcp -> rovo_dev_mcp [style=invis, weight=100];
  }

  investigate -> aws_mcp [label="  invokes", style=dashed];
  investigate -> gcx_cli [label="  invokes", style=dashed];
  investigate -> slack_mcp [label="  invokes", style=dashed];
  investigate -> rovo_dev_mcp [label="  invokes", style=dashed];
}
