// Supplied reference: dark task-flow view of another example project.
digraph TaskFlow {
  rankdir=TB; newrank=true; bgcolor="#0f172a";
  graph [fontname="Trebuchet MS", fontsize=12, fontcolor="#f1f5f9", nodesep=0.65, ranksep=1.1];
  node [fontname="Trebuchet MS", fontsize=12, style=filled, fillcolor="#1e293b", color="#a5b4fc", fontcolor="#f1f5f9", height=0.45];
  edge [fontname="Trebuchet MS", fontsize=11, color="#94a3b8", fontcolor="#a5f3fc"];
  subgraph cluster_steps {
    label="Task lifecycle"; labeljust=l; style=filled; fillcolor="#374151"; color="#374151";
    node [shape=oval];
    plan [label="Plan"]; build [label="Build"]; ship [label="Ship"];
    { rank=same; plan; build; ship; }
    plan -> build -> ship [weight=100];
  }
  subgraph cluster_tools {
    label="Task tools"; labeljust=l; labelloc=b; style=filled; fillcolor="#374151"; color="#374151";
    node [shape=box];
    lint [label="tool-a"]; test [label="tool-b"];
    { rank=same; lint; test; }
    lint -> test [style=invis, weight=100];
  }
  build -> { lint test } [label="  invokes", style=dashed];
}
